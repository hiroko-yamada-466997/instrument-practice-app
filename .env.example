# Copy this file to .env before starting the development environment.
# These values are examples for local development only.
POSTGRES_DB=instrument_practice
POSTGRES_USER=instrument_practice
POSTGRES_PASSWORD=local-development-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Used by the Next.js server to communicate with the backend container.
BACKEND_INTERNAL_URL=http://backend:8000

# Browser-facing URL used after a practice record is submitted.
FRONTEND_PUBLIC_URL=http://localhost:3000
